APP_ENV=dev
APP_NAME=day13-observability-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=day13-chat
LANGFUSE_PROMPT_LABEL=production
# Timeout (giay) cho moi request SDK gui len Langfuse. Mac dinh cua SDK la 5s.
# Neu mang cham, batch span se bi drop am tham (app van tra 200, /health van ok)
# -> trace bi mat. Tang len 20s neu thay log "Failed to export span batch".
LANGFUSE_TIMEOUT=20
